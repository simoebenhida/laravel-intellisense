{
  "name": "laravel-intellisense",
  "displayName": "laravel intellisense",
  "description": "Laravel intellisense for Visual Studio Code",
  "version": "0.3.2",
  "publisher": "mohamedbenhida",
  "icon": "img/laravel.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:artisan"
  ],
  "keywords": [
    "php",
    "intellisense",
    "laravel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/simoebenhida/laravel-intellisense"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "generate_ide_helper",
        "title": "Generate Ide Helper"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Laravel Intellisense",
      "properties": {
        "LaravelIntellisense.model": {
          "type": "string",
          "scope": "resource",
          "default": "App\\Models",
          "description": "The model namespace."
        },
        "LaravelIntellisense.docker": {
          "type": "string",
          "scope": "resource",
          "default": null,
          "description": "Docker command prefix (e.g., 'docker exec app' or 'sail')."
        },
        "LaravelIntellisense.phpPath": {
          "type": "string",
          "scope": "resource",
          "default": "php",
          "description": "Path to the PHP executable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "tsc -p ./",
    "test-compile": "tsc -p ./",
    "watch": "webpack --mode none --watch",
    "lint": "eslint src --ext ts",
    "pretest": "yarn run compile && yarn run lint",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "php-parser": "^3.1.5"
  }
}
